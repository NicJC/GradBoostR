Package: GradBoostR
Type: Package
Title: Gradient Boosting, Random Forests, and Neural Networks
Version: 0.1.0
Authors@R: c(
    person(
        given = "Nic",
        family = "Coxen",
        email = "nicjcoxen@gmail.com",
